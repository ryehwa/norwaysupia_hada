# 백엔드 환경변수 템플릿
#   cp .env.example .env  로 복사한 뒤 값을 채운다.
#   application.yml 에는 기본값이 없으므로 아래 변수가 모두 있어야 기동된다.

# 데이터베이스
# DB_URL 은 & 가 포함되므로 따옴표로 감쌀 것
DB_URL=
DB_USER=
DB_PASSWORD=

# 관리자 계정 — 최초 기동 시 DataInitializer 가 이 값으로 생성한다
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 프론트엔드 주소 · 업로드 경로
FRONTEND_ORIGIN=
UPLOAD_DIR=

# 메일 — SMTP 계정이 없으면 MAIL_ENABLED 를 false 로
MAIL_ENABLED=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TO=
