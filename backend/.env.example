# 백엔드 환경변수 템플릿
#   cp .env.example .env  로 복사한 뒤 값을 채운다.
#   application.yml 에는 기본값이 없으므로 아래 변수가 모두 있어야 기동된다.

# 데이터베이스
# 예) jdbc:postgresql://localhost:5432/hada_db
DB_URL=
DB_USER=
DB_PASSWORD=

# 관리자 계정 — 최초 기동 시 DataInitializer 가 이 값으로 생성한다
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 프론트엔드 주소
FRONTEND_ORIGIN=

# 사진 저장소 (MinIO)
#   MINIO_ENDPOINT        백엔드가 붙는 주소. 예) http://localhost:9000
#   MINIO_PUBLIC_ENDPOINT presigned URL 에 들어가 브라우저가 직접 붙는 주소.
#                         로컬처럼 주소가 같으면 MINIO_ENDPOINT 와 같은 값을 넣는다.
#   MINIO_BUCKET          없으면 기동할 때 자동으로 만든다.
MINIO_ENDPOINT=
MINIO_PUBLIC_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=

# 메일 — SMTP 계정이 없으면 MAIL_ENABLED 를 false 로
MAIL_ENABLED=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TO=
